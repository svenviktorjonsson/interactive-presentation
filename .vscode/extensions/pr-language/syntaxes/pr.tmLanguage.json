{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Presentation",
  "scopeName": "source.pr",
  "patterns": [
    { "include": "#comment" },
    { "include": "#element-view" },
    { "include": "#element-arrow" },
    { "include": "#element-join" },
    { "include": "#element-lines" },
    { "include": "#element-bullets" },
    { "include": "#element-multichoice" },
    { "include": "#element-slider" },
    { "include": "#element-wheel" },
    { "include": "#element-timer" },
    { "include": "#element-pressure" },
    { "include": "#element-spectrum" },
    { "include": "#element-table" },
    { "include": "#element-experiment" },
    { "include": "#element-axis" },
    { "include": "#element-generic" },
    { "include": "#content" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.pr",
      "match": "^\\s*#.*$"
    },
    "element-view": {
      "name": "meta.element.view.pr",
      "begin": "^(view)(\\[)",
      "beginCaptures": {
        "1": { "name": "keyword.control.view.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-common" }]
    },
    "element-arrow": {
      "name": "meta.element.arrow.pr",
      "begin": "^(arrow)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-common" }]
    },
    "element-join": {
      "name": "meta.element.join.pr",
      "begin": "^(join)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-common" }]
    },
    "element-lines": {
      "name": "meta.element.lines.pr",
      "begin": "^(lines|line)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-common" }]
    },
    "element-bullets": {
      "name": "meta.element.bullets.pr",
      "begin": "^(bullets)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-bullets" }]
    },
    "element-multichoice": {
      "name": "meta.element.multichoice.pr",
      "begin": "^(multichoice)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-multichoice" }]
    },
    "element-slider": {
      "name": "meta.element.slider.pr",
      "begin": "^(slider)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-slider" }]
    },
    "element-wheel": {
      "name": "meta.element.wheel.pr",
      "begin": "^(wheel)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-wheel" }]
    },
    "element-timer": {
      "name": "meta.element.timer.pr",
      "begin": "^(timer)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-timer" }]
    },
    "element-pressure": {
      "name": "meta.element.pressure.pr",
      "begin": "^(pressure)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-common" }]
    },
    "element-spectrum": {
      "name": "meta.element.spectrum.pr",
      "begin": "^(spectrum)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-common" }]
    },
    "element-table": {
      "name": "meta.element.table.pr",
      "begin": "^(table)(?=\\s*\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" }
      },
      "end": "^(?=[a-zA-Z_]\\w*\\[[^\\]]+\\])",
      "patterns": [
        {
          "name": "meta.element.table.header.pr",
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.attributes.begin.pr" }
          },
          "end": "(\\])\\s*(:)\\s*$",
          "endCaptures": {
            "1": { "name": "punctuation.definition.attributes.end.pr" },
            "2": { "name": "punctuation.separator.colon.pr" }
          },
          "patterns": [{ "include": "#attributes-common" }]
        },
        { "include": "#comment" },
        {
          "name": "punctuation.separator.delimiter.pr",
          "match": ";"
        }
      ]
    },
    "element-experiment": {
      "name": "meta.element.experiment.pr",
      "begin": "^(experiment)(?=\\s*\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" }
      },
      "end": "^(?=[a-zA-Z_]\\w*\\[[^\\]]+\\])",
      "patterns": [
        {
          "name": "meta.element.experiment.header.pr",
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.attributes.begin.pr" }
          },
          "end": "(\\])\\s*(:)\\s*$",
          "endCaptures": {
            "1": { "name": "punctuation.definition.attributes.end.pr" },
            "2": { "name": "punctuation.separator.colon.pr" }
          },
          "patterns": [{ "include": "#attributes-common" }]
        },
        { "include": "#comment" },
        {
          "name": "punctuation.separator.delimiter.pr",
          "match": ";"
        }
      ]
    },
    "element-axis": {
      "name": "meta.element.axis.pr",
      "begin": "^(axis)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-axis" }]
    },
    "element-generic": {
      "name": "meta.element.generic.pr",
      "begin": "^(text|image|iframe|button|buttons|input|video|camera|webcam|player|audio|shape|group|table)(\\[)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.element.pr" },
        "2": { "name": "punctuation.definition.attributes.begin.pr" }
      },
      "end": "(\\])\\s*(:)?\\s*(.*)$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.attributes.end.pr" },
        "2": { "name": "punctuation.separator.colon.pr" },
        "3": { "name": "meta.content.pr" }
      },
      "patterns": [{ "include": "#attributes-common" }]
    },

    "attributes-bullets": {
      "patterns": [
        {
          "comment": "type for bullets - valid: A, a, 1, X, i, I with optional suffix (., -), or standalone . or -",
          "match": "(type)(=)(?:[AaXxIi1](?:\\.|-)?|\\.|-)(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "support.constant.known.pr" }
          }
        },
        {
          "comment": "type for bullets - invalid",
          "match": "(type)(=)([^,\\]]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "invalid.illegal.type.pr" }
          }
        },
        { "include": "#attributes-common" }
      ]
    },

    "attributes-multichoice": {
      "patterns": [
        {
          "comment": "type for multichoice (bullet style) - valid: A, a, 1, i, I",
          "match": "(type)(=)(A|a|1|i|I)(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "support.constant.known.pr" }
          }
        },
        {
          "comment": "type for multichoice - invalid",
          "match": "(type)(=)([^,\\]]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "invalid.illegal.type.pr" }
          }
        },
        { "include": "#attributes-common" }
      ]
    },


    "attributes-wheel": {
      "patterns": [
        {
          "comment": "type for wheel (bullet style) - valid: A, a, 1, i, I",
          "match": "(type)(=)(A|a|1|i|I)(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "support.constant.known.pr" }
          }
        },
        {
          "comment": "type for wheel - invalid",
          "match": "(type)(=)([^,\\]]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "invalid.illegal.type.pr" }
          }
        },
        { "include": "#attributes-common" }
      ]
    },

    "attributes-timer": {
      "patterns": [
        {
          "comment": "stat for timer - valid: gaussian, linear, uniform, normal",
          "match": "(stat)(=)(gaussian|linear|uniform|normal)(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "support.constant.known.pr" }
          }
        },
        {
          "comment": "stat for timer - invalid",
          "match": "(stat)(=)([^,\\]]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "invalid.illegal.stat.pr" }
          }
        },
        { "include": "#attributes-common" }
      ]
    },

    "attributes-axis": {
      "patterns": [
        {
          "comment": "axis limits",
          "match": "(xMin|xMax|yMin|yMax|padPx|maxPoints)(=)(-?(?:\\d+\\.?\\d*|\\.\\d+))(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "constant.numeric.pr" }
          }
        },
        {
          "comment": "axis clamp - valid: 0, 1, true, false",
          "match": "(clamp)(=)(0|1|true|false)(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "support.constant.known.pr" }
          }
        },
        {
          "comment": "axis clamp - invalid",
          "match": "(clamp)(=)([^,\\]]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "invalid.illegal.clamp.pr" }
          }
        },
        { "include": "#attributes-common" }
      ]
    },

    "attributes-slider": {
      "patterns": [
        {
          "comment": "slider numeric attributes",
          "match": "(min|max|step|value)(=)(-?(?:\\d+\\.?\\d*|\\.\\d+))(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "constant.numeric.pr" }
          }
        },
        {
          "comment": "slider values list",
          "match": "(values|vals|valueList)(=)(\\([^\\)]*\\))",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": {
              "patterns": [
                { "name": "punctuation.definition.group.begin.pr", "match": "\\(" },
                { "name": "punctuation.definition.group.end.pr", "match": "\\)" },
                { "name": "punctuation.separator.comma.pr", "match": "," },
                { "name": "constant.numeric.pr", "match": "-?(?:\\d+\\.?\\d*|\\.\\d+)" }
              ]
            }
          }
        },
        {
          "comment": "slider orientation - valid: horizontal, vertical",
          "match": "(orientation)(=)(horizontal|vertical)(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "support.constant.known.pr" }
          }
        },
        {
          "comment": "slider orientation - invalid",
          "match": "(orientation)(=)([^,\\]]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "invalid.illegal.type.pr" }
          }
        },
        { "include": "#attributes-common" }
      ]
    },

    "attributes-common": {
      "patterns": [
        {
          "comment": "generic attribute with tuple value (captures commas so numbers highlight correctly)",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)(=)(\\([^\\)]*\\))",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": {
              "patterns": [
                { "name": "punctuation.definition.group.begin.pr", "match": "\\(" },
                { "name": "punctuation.definition.group.end.pr", "match": "\\)" },
                { "name": "punctuation.separator.comma.pr", "match": "," },
                {
                  "comment": "time literal (mm:ss, mm:ss.fraction, hh:mm:ss, hh:mm:ss.fraction)",
                  "name": "constant.numeric.pr",
                  "match": "(?<![0-9])(?:\\d{2}:\\d{2}(?::\\d{2})?)(?:\\.\\d+)?(?![0-9])"
                },
                { "name": "constant.numeric.pr", "match": "-?(?:\\d+\\.?\\d*|\\.\\d+)" }
              ]
            }
          }
        },
        {
          "comment": "generic attribute with range value (start:step:end)",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)(=)(-?(?:\\d+\\.?\\d*|\\.\\d+))(:)(-?(?:\\d+\\.?\\d*|\\.\\d+))(:)(-?(?:\\d+\\.?\\d*|\\.\\d+))(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "constant.numeric.pr" },
            "4": { "name": "punctuation.separator.colon.pr" },
            "5": { "name": "constant.numeric.pr" },
            "6": { "name": "punctuation.separator.colon.pr" },
            "7": { "name": "constant.numeric.pr" }
          }
        },
        {
          "comment": "color attributes - valid colors",
          "match": "(bgColor|barColor|lineColor|fgColor|color|fillColor|strokeColor)(=)(white|black|red|green|blue|yellow|cyan|magenta|orange|purple|pink|gray|grey|transparent|#[0-9a-fA-F]{3,4}|#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8})(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "support.constant.known.pr" }
          }
        },
        {
          "comment": "color attributes - invalid color",
          "match": "(bgColor|barColor|lineColor|fgColor|color|fillColor|strokeColor)(=)([^,\\]]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "invalid.illegal.color.pr" }
          }
        },
        {
          "comment": "loc attribute - valid locations",
          "match": "(loc)(=)(left|right|up|down|top|bottom|center|north|south|east|west|above|below)(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "support.constant.known.pr" }
          }
        },
        {
          "comment": "loc attribute - invalid location",
          "match": "(loc)(=)([^,\\]]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "invalid.illegal.loc.pr" }
          }
        },
        {
          "comment": "showTime attribute - valid: 0, 1, true, false",
          "match": "(showTime)(=)(0|1|true|false)(?=[,\\]]|$)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "support.constant.known.pr" }
          }
        },
        {
          "comment": "showTime attribute - invalid",
          "match": "(showTime)(=)([^,\\]]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "name": "invalid.illegal.showTime.pr" }
          }
        },
        {
          "comment": "generic attribute with object value",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)(=)(\\{[^}]*\\})",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": { "patterns": [{ "include": "#object-contents" }] }
          }
        },
        {
          "comment": "generic attribute with any value",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)(=)([^,\\]]*)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.pr" },
            "2": { "name": "keyword.operator.assignment.pr" },
            "3": {
              "patterns": [
                {
                  "name": "meta.template.pr",
                  "match": "\\{\\{[^}]+\\}\\}"
                },
                {
                  "name": "support.constant.known.pr",
                  "match": "\\b(true|false)\\b"
                },
                {
                  "comment": "time literal (mm:ss, mm:ss.fraction, hh:mm:ss, hh:mm:ss.fraction)",
                  "name": "constant.numeric.pr",
                  "match": "(?<![0-9])(?:\\d{2}:\\d{2}(?::\\d{2})?)(?:\\.\\d+)?(?![0-9])"
                },
                {
                  "name": "constant.numeric.pr",
                  "match": "\\b-?[0-9]+\\.?[0-9]*\\b"
                },
                {
                  "name": "variable.other.arbitrary.pr",
                  "match": ".+"
                }
              ]
            }
          }
        },
        {
          "name": "punctuation.separator.comma.pr",
          "match": ","
        }
      ]
    },

    "object-contents": {
      "patterns": [
        {
          "name": "punctuation.definition.object.begin.pr",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.object.end.pr",
          "match": "\\}"
        },
        {
          "name": "meta.object-entry.pr",
          "match": "([^:,{}]+)\\s*(:)\\s*([^,{}]+)",
          "captures": {
            "1": { "name": "variable.other.object-key.pr" },
            "2": { "name": "punctuation.separator.colon.pr" },
            "3": {
              "patterns": [
                {
                  "name": "support.constant.known.pr",
                  "match": "^\\s*(?:\\b(white|black|red|green|blue|yellow|cyan|magenta|orange|purple|pink|gray|grey|transparent)\\b|#[0-9a-fA-F]{3,4}|#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8})\\s*$"
                },
                {
                  "name": "variable.other.object-value.pr",
                  "match": ".+"
                }
              ]
            }
          }
        }
      ]
    },

    "content": {
      "name": "meta.content.pr",
      "match": "^(?!#|view|arrow|join|text|image|iframe|bullets|timer|pressure|spectrum|choices|poll|wheel|button|buttons|input|video|camera|webcam|player|audio|shape|group|table|experiment|graph|axis|lines|line).+$"
    }
  }
}

