axis[id=timer_main_axis, visible=true, opacity=1, xMin=0.0, xMax=10.0, yMin=0.0, yMax=1.0, clamp=True, padPx=40, maxPoints=200, bins=[0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0]]
buttons[id=timer_main_buttons, visible=true, opacity=1, bgColor=black, bgAlpha=0.7, items={{{toggleLabel}}:timer-toggle}]
text[id=timer_main_stats, visible=true, opacity=1, color=rgba(255,255,255,0.92), align=center]: \mu={{mu:.2f}} \sigma={{sigma:.2f}}
text[id=timer_main_x_label, visible=true, opacity=1, color=rgba(255,255,255,0.92), align=center]: {{xLabel}}
text[id=timer_main_y_label, visible=true, opacity=1, color=rgba(255,255,255,0.92), align=center]: {{yLabel}}
