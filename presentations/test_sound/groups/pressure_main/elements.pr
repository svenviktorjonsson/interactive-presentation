axis[id=pressure_main_axis, visible=true, opacity=1, xMin=0.0, xMax=30.0, yMin=0.0, yMax=1.1, clamp=True, padPx=40, maxPoints=10000]
buttons[id=pressure_main_buttons, visible=true, opacity=1, bgColor=black, bgAlpha=0.7, items={{{runPauseResume}}:pressure-toggle}, type=click, rows=1, cols=1]
table[id=pressure_main_table, visible=true, opacity=1, bgColor=white, color=black, rows=12, cols=1, editable=true, hHeader=[Peak t (s)], hStyle=[center]]:

slider[id=pressure_main_threshold, visible=true, opacity=1, min=0.0, max=1.0, step=0.01, values=0.0:0.01:1.0, value=0.5, orientation=horizontal]
text[id=pressure_main_x_label, visible=true, opacity=1, color=rgba(255,255,255,0.92), align=center]: {{xLabel}}
text[id=pressure_main_y_label, visible=true, opacity=1, color=rgba(255,255,255,0.92), align=center]: {{yLabel}}
